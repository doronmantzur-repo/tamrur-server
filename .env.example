# Port the server listens on (defaults to 8080 if unset)
PORT=8080

JWT_SECRET=
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth (used to create/verify accounts in auth.users)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Client origin allowed by CORS: http://localhost:5173 for local development,
# or your deployed frontend URL in production
CLIENT_URL=

# Used by /medic-query/ask to generate answers from the retrieved PDF excerpts
ANTHROPIC_API_KEY=

# Used to embed medic-query search questions via Voyage AI's hosted API
# (data/embeddings.json was built with the same provider/model - see pdf-parse/pdf-manager.js)
VOYAGE_API_KEY=