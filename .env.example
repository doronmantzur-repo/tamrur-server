JWT_SECRET=
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth (used to create/verify accounts in auth.users)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Client URL (used for cors) https://localhost:5173 for local development, or your deployed frontend URL in production
CLIENT_URL=

# Used by /medic-query/ask to generate answers from the retrieved PDF excerpts
ANTHROPIC_API_KEY=